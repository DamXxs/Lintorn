# --- SYSTEM & OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- PYTHON & BACKEND ----
# Environnements virtuels (Windows/Linux)
damxscorp/backend/venv/
damxscorp/backend/.venv/
damxscorp/backend/env/
# Cache Python
**/__pycache__/
**/*.py[cod]
# Base de données et fichiers locaux
damxscorp/backend/db.sqlite3
damxscorp/backend/staticfiles/
damxscorp/backend/media/

# --- NODE & FRONTEND ---
# Dépendances (Le plus lourd)
damxscorp/frontend/node_modules/
# Fichiers de build (Production)
damxscorp/frontend/build/
damxscorp/frontend/dist/
# Logs d'erreur
damxscorp/frontend/npm-debug.log*
damxscorp/frontend/yarn-debug.log*
damxscorp/frontend/yarn-error.log*
# Fichiers PnP
damxscorp/frontend/.pnp/
damxscorp/frontend/.pnp.js

# --- ENVIRONNEMENT & SECRETS (TRÈS IMPORTANT) ---
# On ignore tous les .env partout dans le projet
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# --- DOCKER & CONTAINERS ---
.devcontainer/