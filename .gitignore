# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environnements virtuels — jamais versionnés : ils dépendent de l'OS et pèsent lourd
venv/
.venv/
env/

# --- Secrets et config machine ---
# Le .env porte des chemins et des clés propres à UNE machine.
# Seul le .env.example (sans valeur réelle) est versionné.
.env
*.env
!.env.example

# --- Sorties de Lintorn lui-même ---
# Un fait sur le code se recalcule, il ne se versionne pas.
rapport_Lintorn.md
# État LOCAL (date du dernier audit complet) : propre à CHAQUE machine.
# Le versionner ferait croire à un collègue que SON poste est à jour.
.lintorn_etat.json

# --- Outils ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Éditeurs / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Sorties de Lintorn sur lui-meme — la config, elle, est versionnee.
.lintorn/*
!.lintorn/config.toml

# Notes personnelles de relecture : elles restent sur MA machine.
# ⚠️ Une branche ne rend rien prive — sur un depot public, une branche poussee
# est publique comme le reste. C'est CE fichier qui decide de ce qui sort.
# ⚠️ Et .gitignore n'ignore QUE les fichiers pas encore suivis : si une note a
# deja ete commitee, il faut la desindexer avec `git rm -r --cached .notes/`.
.notes/
